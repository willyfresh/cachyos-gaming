// ────────────── Output Configuration ──────────────
// niri msg outputs  — connector, serial, and live position
// https://github.com/YaLTeR/niri/wiki/Configuration:-Outputs
//
// Two ASUS VE247s, side by side. Positions are in logical pixels.
// The cursor only crosses monitors that actually touch.

// Left: DP-1, serial K1LMQS100417
output "Ancor Communications Inc VE247 K1LMQS100417" {
    mode "1920x1080@60.000"
    scale 1
    position x=0 y=0
    focus-at-startup
}

// Right: HDMI-A-1, serial C5LMQS118094
output "Ancor Communications Inc VE247 C5LMQS118094" {
    mode "1920x1080@60.000"
    scale 1
    position x=1920 y=0
}

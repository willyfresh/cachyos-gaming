    layout {
        gaps 10
        center-focused-column "never"

        background-color "transparent" // noctalia-shell sets the wallpaper

        preset-column-widths {
            proportion 0.33333
            proportion 0.5
            proportion 0.66667
        }

        // Cube chassis: sharp corners live in rules.kdl. Every window
        // has a metal edge; the focused one gets the energy-green ring.
        focus-ring {
            width 3
            active-color "#5CFF6B"
            inactive-color "#2A3D2E"
        }

        border {
            width 2
            active-color "#5CFF6B"
            inactive-color "#2A3D2E"
            urgent-color "#8B1A1A"
        }

        struts {}
    }

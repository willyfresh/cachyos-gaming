    window-rule {
        geometry-corner-radius 0
        clip-to-geometry true
        // Draw the green/metal edge around the window, not behind it.
        draw-border-with-background false
    }

    window-rule {
        background-effect {
          blur true
          xray false
        }
    }

    // Floating Noctalia settings window.
    window-rule {
        match app-id="dev.noctalia.Noctalia"
        open-floating true
        default-column-width { fixed 1080; }
        default-window-height { fixed 920; }
    }

    // Steam menus are X11 child windows (empty title). clip-to-geometry plus
    // focus-follows-mouse makes them flash and vanish on niri/xwayland-satellite.
    window-rule {
        match app-id="steam"
        clip-to-geometry false
        geometry-corner-radius 0
    }

    window-rule {
        match app-id="steam"
        exclude title=r#"^[Ss]team$"#
        open-floating true
    }

    window-rule {
        match app-id="steam" title=r#"^$"#
        open-floating true
        min-width 1
        min-height 1
    }

    window-rule {
       match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#
       default-floating-position x=10 y=10 relative-to="bottom-right"
       open-focused false
    }

    // Windowed so the Steam overlay Xbox login can receive mouse/keyboard.
    window-rule {
        match app-id=r#"^steam_app_1240440$"#
        open-fullscreen false
        open-maximized true
        clip-to-geometry false
        geometry-corner-radius 0
    }

    // Splitgate: Arena Reloaded — exclusive fullscreen fights niri.
    window-rule {
        match app-id=r#"^steam_app_2918300$"#
        open-fullscreen false
        open-maximized true
        clip-to-geometry false
        geometry-corner-radius 0
    }

    // Super+Ctrl+T activity monitor. Same job as Omarchy's floating btop.
    // New floating windows already open centered; this only sizes it.
    window-rule {
        match app-id="btop"
        open-floating true
        default-column-width { proportion 0.55; }
        default-window-height { proportion 0.65; }
    }

    // niri-screensaver: one fullscreen Alacritty per output.
    window-rule {
        match app-id="niri-screensaver"
        open-fullscreen true
        open-focused true
    }

    // Board Game Arena is a title-less Chrome --app window (launch-webapp.sh),
    // not a PWA (--app-id draws a CSD title bar niri cannot strip).
    window-rule {
        match app-id="chrome-boardgamearena.com-Default"
        open-fullscreen false
        open-maximized true
    }

    // Ubisoft Connect (upc.exe) is X11 via xwayland-satellite, like Steam.
    window-rule {
        match app-id="upc.exe"
        clip-to-geometry false
        geometry-corner-radius 0
        open-maximized false
    }

    // Halo/Xbox sign-in is a Steam overlay web view titled Big Picture.
    window-rule {
        match app-id="steam" title="Steam Big Picture Mode"
        open-floating true
        open-focused true
        clip-to-geometry false
        geometry-corner-radius 0
        min-width 1
        min-height 1
    }

    layer-rule {
        match namespace="^noctalia-wallpaper"
        place-within-backdrop true
    }

    layer-rule {
        match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd)$"
        background-effect {
          xray false
          // blur false
        }
    }

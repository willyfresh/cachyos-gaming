#!/usr/bin/env bash
# Inner driver for the Novalis screensaver. Same argv as niri-screensaver:
#   run [--seed N] [--logo PATH] [--measure-logical WxH]
# Sequence: matrix rain never stops. Each fact locks white as drops hit
# its cells, holds to be read, then the NOVALIS wordmark forms the same
# way. Next fact, logo, repeat. No flower, no tunnel.
set -uo pipefail
exec 2>>"${XDG_RUNTIME_DIR:-/tmp}/novalis-screensaver.log"
echo "$(date -Iseconds) start argv=$* tty=$(tty 2>/dev/null || echo none)" >&2

SCREENSAVER_DIR="${SCREENSAVER_DIR:-$HOME/.config/niri-screensaver}"
CONFIG_FILE="${CONFIG_FILE:-${SCREENSAVER_DIR}/config}"
LOGO_FILE="${LOGO_FILE:-${SCREENSAVER_DIR}/logo.txt}"
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
RAIN="$SCRIPT_DIR/novalis-rain.py"
SELF_NAME="$(basename "$0")"
DISMISS_ON_KEY="${DISMISS_ON_KEY:-true}"
CURSOR_HIDE="${CURSOR_HIDE:-true}"
SEED=""

[[ -f "$CONFIG_FILE" ]] && source "$CONFIG_FILE"
: "${LOGO_FILE:=${SCREENSAVER_DIR}/logo.txt}"

while [[ $# -gt 0 ]]; do
  case "$1" in
    run) shift ;;
    --logo) LOGO_FILE="$2"; shift 2 ;;
    --seed) SEED="$2"; shift 2 ;;
    --measure-logical) shift 2 ;;
    *) shift ;;
  esac
done

CHILD_PID=""

exit_screensaver() {
  trap - SIGINT SIGTERM SIGHUP SIGQUIT EXIT
  if [[ -n "$CHILD_PID" ]]; then
    kill "$CHILD_PID" 2>/dev/null || true
    wait "$CHILD_PID" 2>/dev/null || true
  fi
  pkill -P $$ -x python3 2>/dev/null || true
  printf '\e[?1003l' 2>/dev/null
  tput cnorm 2>/dev/null
  tput reset 2>/dev/null
  stty echo 2>/dev/null
  exit 0
}

terminate_siblings() {
  local self=$$ pid cmd
  for pid in /proc/[0-9]*; do
    pid="${pid#/proc/}"
    [[ "$pid" == "$self" ]] && continue
    cmd="$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null)" || continue
    [[ "$cmd" == *"${SELF_NAME} run "* ]] && kill -TERM "$pid" 2>/dev/null
  done
}

dismiss_all() {
  terminate_siblings
  exit_screensaver
}

trap exit_screensaver SIGINT SIGTERM SIGHUP SIGQUIT EXIT
STARTED_AT=$SECONDS
echo "$(date -Iseconds) running logo=$LOGO_FILE rain=$RAIN seed=${SEED:-none}" >&2

stty -echo 2>/dev/null || true
[[ "$CURSOR_HIDE" != "false" ]] && tput civis
printf '\033]11;rgb:00/00/00\007'

run_child() {
  echo "$(date -Iseconds) child: $*" >&2
  "$@" </dev/null 2>>"${XDG_RUNTIME_DIR:-/tmp}/novalis-screensaver.log" &
  CHILD_PID=$!
  sleep 0.15
  if ! kill -0 "$CHILD_PID" 2>/dev/null; then
    wait "$CHILD_PID" 2>/dev/null || true
    echo "$(date -Iseconds) child exited immediately pid=$CHILD_PID" >&2
    CHILD_PID=""
    return 0
  fi
  while read -r -s -n1 -t 0.01 2>/dev/null; do :; done
  printf '\e[?1003h'
  sleep 0.35
  while read -r -s -n1 -t 0.05 2>/dev/null; do :; done
  while kill -0 "$CHILD_PID" 2>/dev/null; do
    if read -r -s -n1 -t 0.4 key 2>/dev/null; then
      if (( SECONDS - STARTED_AT < 2 )); then
        continue
      fi
      if [[ "$key" == $'\e' ]]; then
        read -r -s -n5 -t 0.01 2>/dev/null || true
        echo "$(date -Iseconds) dismiss (esc/mouse)" >&2
        dismiss_all
      elif [[ "$DISMISS_ON_KEY" != "false" ]]; then
        echo "$(date -Iseconds) dismiss (key)" >&2
        dismiss_all
      fi
    fi
  done
  wait "$CHILD_PID" 2>/dev/null || true
  CHILD_PID=""
  printf '\e[?1003l'
}

rain_args=(python3 "$RAIN" "$LOGO_FILE")
[[ -n "$SEED" ]] && rain_args+=(--seed "$SEED")

while true; do
  run_child "${rain_args[@]}"
done
